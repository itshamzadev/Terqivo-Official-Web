# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional public URL for a separately hosted API/static upload server.
# Leave empty when the Vite app and Express server share the same origin.
VITE_API_URL=""

# Optional persistent filesystem location for uploaded images.
# Used only as a local-development fallback when MongoDB is unavailable.
UPLOAD_DIR=""

# Durable upload storage. Keep this as gridfs in production so uploads live in MongoDB.
UPLOAD_STORAGE="gridfs"
GRIDFS_BUCKET="terqivoUploads"

# MongoDB connection string
MONGODB_URI="mongodb+srv://..."

# Admin Credentials
ADMIN_EMAIL="admin@terqivo.com"
ADMIN_PASSWORD="your_secure_password"

# JWT secret for authentication
JWT_SECRET="your_jwt_secret"

# Server-side SMTP configuration. Never expose these values to Vite/frontend code.
EMAIL_ENABLED="true"
# These SMTP values come from your email provider/cPanel/hosting panel.
SMTP_HOST="mail.terqivo.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="support@terqivo.com"
SMTP_PASSWORD=""
SMTP_FROM_NAME="Terqivo Support"
SMTP_FROM_EMAIL="support@terqivo.com"
SMTP_REPLY_TO="support@terqivo.com"
ADMIN_NOTIFICATION_EMAIL="support@terqivo.com"

# Free WhatsApp Web alerts. No Meta token or paid Cloud API account is needed.
WHATSAPP_ENABLED="true"
WHATSAPP_PROVIDER="web"
# Scan the QR code with this business WhatsApp account; it is the sender account.
# The notification recipient below is intentionally a different number.
WHATSAPP_ADMIN_PHONE="03470028168"
WHATSAPP_CLIENT_ID="terqivo-admin"
# Leave these empty unless your hosting provider requires custom paths.
# The QR code is scanned from Admin Panel > WhatsApp Alerts.
WHATSAPP_SESSION_DIR=""
CHROMIUM_PATH=""

# Leave these blank while WHATSAPP_PROVIDER=web. They are only for the paid/official Cloud API.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_API_VERSION=""
# Only used with the official Cloud API.
WHATSAPP_NOTIFICATION_TEMPLATE=""
WHATSAPP_TEMPLATE_LANGUAGE="en_US"
